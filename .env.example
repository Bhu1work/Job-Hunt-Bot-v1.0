# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── LinkedIn (your own account credentials for scraping) ─────────────────────
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=yourpassword

# ── Hunter.io ─────────────────────────────────────────────────────────────────
HUNTER_API_KEY=your_hunter_key

# ── Apollo.io ─────────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_key

# ── Google Sheets (optional) ──────────────────────────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google_service_account.json

# ── Slack Bot ─────────────────────────────────────────────────────────────────
# Setup: https://api.slack.com/apps → Create App → From scratch
#
# 1. Bot Token  (xoxb-...)  → OAuth & Permissions → Install to Workspace
SLACK_BOT_TOKEN=xoxb-...
#
# 2. App-Level Token (xapp-...) → Settings → Socket Mode → Enable → Generate token
#    Required scope: connections:write
SLACK_APP_TOKEN=xapp-...
#
# 3. Channel ID (C...)  → open #job-hunt in Slack → copy ID from URL
SLACK_CHANNEL_ID=C...

# ── Optional: Incoming Webhook for digest messages ────────────────────────────
SLACK_WEBHOOK_URL=

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx   # Gmail App Password

# ── Personal info ─────────────────────────────────────────────────────────────
YOUR_NAME=Your Full Name
YOUR_EMAIL=you@gmail.com
YOUR_PHONE=+1 (555) 000-0000
YOUR_LINKEDIN=linkedin.com/in/yourhandle
YOUR_GITHUB=github.com/yourhandle
YOUR_FIELD=Data Engineering
YOUR_VISA_STATUS=Requires H1B Sponsorship
YOUR_LOCATION=New York, USA

# ── Paths ─────────────────────────────────────────────────────────────────────
MASTER_RESUME_PATH=assets/master_resume.txt
RESUME_PDF_PATH=Resume/YOURNAME.pdf
DB_PATH=data/jobs.db
